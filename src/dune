(library
 ; The solver: every .ml and .mli in this directory is a module of it. vstiff.ml is the main module and
 ; lists the public ones, so outside, bdf2.ml is Vstiff.Bdf2 (the tests write open Vstiff) while stage.ml
 ; and check.ml stay internal; inside, every module uses the short names.
 (name vstiff)
 ; The numerical kernel in numerics/, a library of its own; modules here name what they use from it.
 (libraries numerics)
 ; Not installed with the library either.
 (private_modules stage check)
 ; ode.mli holds only types and module types, so there is no ode.ml, and dune has to be told.
 (modules_without_implementation ode))

; Not set on purpose: flags (dune's dev profile applies, where an unused variable or a misplaced doc comment
; fails the build). Only the OCaml standard library and the kernel are allowed as dependencies.
